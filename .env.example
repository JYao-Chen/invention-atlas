PATENT_USERNAME=jyao
PATENT_PASSWORD=
DASHSCOPE_API_KEY=
PATENT_MODEL=qwen3.8-flash
PATENT_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PATENT_EMBEDDING_MODEL=text-embedding-v4
PATENT_DATA_DIR=./data
# 组织聊天模型凭据的AES-256密钥，64位十六进制；独立保存，不随数据库导出
PATENT_MODEL_CREDENTIAL_KEY=
# 必填：独立PostgreSQL业务数据库；首次运行前执行scripts/migrate-postgres.ts
DATABASE_URL=postgresql://atlas_user:replace-me@127.0.0.1:5432/invention_atlas
# MinerU Cloud: new OCR jobs use this engine when its key is configured.
# Keep credentials on the server, never in NEXT_PUBLIC variables.
PATENT_MINERU_API_KEY=
PATENT_MINERU_BASE_URL=https://mineru.net/api/v4
PATENT_MINERU_MODEL=vlm
PATENT_MINERU_LANGUAGE=ch
# 仅后台执行进程使用：可跨项目维护jobs的连接，不得给Web业务查询使用
QUEUE_DATABASE_URL=postgresql://atlas_queue:replace-me@127.0.0.1:5432/invention_atlas
# 仅测试使用，不得指向生产；每个测试文件建立并清理独立schema
PG_TEST_DATABASE_URL=postgresql://atlas_test:replace-me@127.0.0.1:5432/invention_atlas_test
# 可选：服务器无法直连 Hugging Face 时，使用自管的 rows 接口转发地址
PATENT_DATASET_ROWS_URL=
# 仅MCP客户端进程使用，不是模型供应商地址；密钥来自管理菜单“接口凭据”
ATLAS_API_URL=http://127.0.0.1:3017/api/
ATLAS_API_TOKEN=
# HTTP MCP进程仅监听127.0.0.1；公网由已授权的HTTPS反向代理接入
ATLAS_MCP_PORT=3032
# 反向代理转发的Host／浏览器Origin主机名，不含协议或端口；本地可留空
ATLAS_MCP_PUBLIC_HOSTNAME=
# PDF依赖完整LibreOffice Writer/Math；默认使用系统安装，可指定隔离运行目录
PATENT_PDF_LIBREOFFICE_DIR=/usr/lib/libreoffice
PATENT_PDF_REGISTRY_DIR=/etc/libreoffice/registry
